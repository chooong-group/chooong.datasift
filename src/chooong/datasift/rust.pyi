from collections.abc import Iterator

from chooong.datasift.models import CellValue

class BatchIterator(Iterator[list[dict[str, CellValue]]]):
    def __iter__(self) -> BatchIterator: ...
    def __next__(self) -> list[dict[str, CellValue]]: ...
    def close(self) -> None: ...
    def statistics_json(self) -> str | None: ...

def iter_batches(xlsx_path: str, filter_json: str, batch_size: int = 1024) -> BatchIterator: ...

class EventIterator(Iterator[list[str]]):
    def __iter__(self) -> EventIterator: ...
    def __next__(self) -> list[str]: ...
    def close(self) -> None: ...
    def statistics_json(self) -> str | None: ...

def iter_many(paths: list[str], filter_json: str, batch_size: int = 1024) -> BatchIterator: ...
def iter_events(
    paths: list[str], filter_json: str, batch_size: int = 1024, rejected: bool = True
) -> EventIterator: ...
def iter_json(paths: list[str], filter_json: str, batch_size: int = 1024) -> EventIterator: ...
def export(
    paths: list[str],
    filter_json: str,
    output: str,
    rejected_output: str | None = None,
    batch_size: int = 1024,
) -> str: ...
def recover_export(output: str) -> None: ...
def expand_inputs(paths: list[str]) -> list[str]: ...
